# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be pushed to GitHub.

PORT=3000
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/open_space_parking

# Razorpay (leave empty to use demo checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Local demo accounts (do not use these in production)
DEFAULT_ADMIN_EMAIL=admin@openspace.local
DEFAULT_ADMIN_PASSWORD=Admin@1234
DEFAULT_SECURITY_EMAIL=security@openspace.local
DEFAULT_SECURITY_PASSWORD=Security@1234
