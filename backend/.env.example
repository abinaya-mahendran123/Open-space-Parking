# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be pushed to GitHub.

PORT=3000

# Supabase Postgres (preferred). When set, local Mongo is not used.
# Database settings → Connection string → URI (use Session or Transaction pooler).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Leave empty when using DATABASE_URL.
MONGO_CONNECTION_STRING=

# Razorpay (leave empty to use demo checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Phone Auth — Web API key from Project settings → General
FIREBASE_WEB_API_KEY=

# FCM push — download service account JSON from Firebase:
# Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional: paste the whole JSON on one line instead of a file path
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=open-space-parking

# Local demo accounts (do not use these in production)
DEFAULT_ADMIN_EMAIL=admin@openspace.local
DEFAULT_ADMIN_PASSWORD=Admin@1234
DEFAULT_SECURITY_EMAIL=security@openspace.local
DEFAULT_SECURITY_PASSWORD=Security@1234
