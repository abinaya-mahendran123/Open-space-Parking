# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be pushed to GitHub.

PORT=3000

# Supabase Postgres (preferred). When set, local Mongo is not used.
# Database settings → Connection string → URI (use Session or Transaction pooler).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Leave empty when using DATABASE_URL.
MONGO_CONNECTION_STRING=

# Razorpay (leave empty to use demo checkout)
RAZORPAY_KEY_ID= 
RAZORPAY_KEY_SECRET=

# Razorpay linked account that receives the 10% platform commission.
# For testing: use your own acc_... ID.
# For production: replace with the official company account ID.
RAZORPAY_COMPANY_ACCOUNT_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MSG91 SMS (preferred for OTP on Indian mobiles)
# Use either FLOW_ID (recommended) or TEMPLATE_ID with sender id.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4

# Twilio WhatsApp / fallback messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Local demo accounts (do not use these in production)
DEFAULT_ADMIN_EMAIL=admin@openspace.local
DEFAULT_ADMIN_PASSWORD=Admin@1234
DEFAULT_SECURITY_EMAIL=security@openspace.local
DEFAULT_SECURITY_PASSWORD=Security@1234
