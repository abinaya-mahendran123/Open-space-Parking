# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be pushed to GitHub.

# Strong secret for API JWTs issued on login (required in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set NODE_ENV=production on Render so OTP console fallback and weak JWT are blocked.
# NODE_ENV=production

# Comma-separated allowed browser origins for CORS (production).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

PORT=3000

# Optional public API origin used when building /uploads/... file URLs
# (useful behind proxies / on Render). Example: https://open-space-parking.onrender.com
PUBLIC_BASE_URL=

# REQUIRED for production: Supabase Postgres connection string.
# Database settings → Connection string → URI (Session or Transaction pooler).
# When set, the API never starts a MongoDB client.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Leave EMPTY for Supabase-only production. Do not set a Mongo Atlas URI.
MONGO_CONNECTION_STRING=

# Razorpay (leave empty to use demo checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Route linked account for the 10% platform commission.
# For E Star merchant setup: leave EMPTY so 10% stays on the merchant account
# after the 90% land-owner transfer. Set only if you want commission in a separate acc_...
RAZORPAY_COMPANY_ACCOUNT_ID=

# Display name for the 10% platform share on receipts / notifications.
PLATFORM_ACCOUNT_NAME=E Star
PLATFORM_COMMISSION_PERCENT=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In (Web OAuth client from Firebase / Google Cloud)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# FCM push — download service account JSON from Firebase:
# Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional: paste the whole JSON on one line instead of a file path
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=open-space-parking

# Optional: entry QR validity in ms (default 2 hours = 7200000)
# QR_ENTRY_VALIDITY_MS=7200000

# PaddleOCR worker (Python) — see python/paddleocr_service/README.md
PADDLEOCR_SERVICE_URL=http://127.0.0.1:8765
PADDLEOCR_TIMEOUT_MS=180000
PADDLEOCR_MAX_CONCURRENT=1
PADDLEOCR_LANGS=en
# On Render free/512MB: leave ENABLE_PADDLEOCR unset (auto-skipped).
# On Render Standard 2GB+: ENABLE_PADDLEOCR=1
# FORCE low-RAM OCR mode (smaller images, 1 OCR at a time, free Tesseract after each job).
# Auto-on when RENDER=true. Set LOW_MEMORY_OCR=0 on a large VPS if you want full quality.
# LOW_MEMORY_OCR=1
# OCR_MAX_CONCURRENT_REQUESTS=1
# JSON_BODY_LIMIT=10mb
# UPLOAD_MAX_BYTES=8388608
# Optional: PADDLEOCR_LANGS=en,ta,hi  (slower cold start / more RAM)
# PADDLEOCR_PYTHON=python
# PADDLEOCR_SCRIPT=../python/paddleocr_service/main.py

DEFAULT_ADMIN_EMAIL=admin@openspace.local
# Change before public launch — default Admin@1234 is rejected for production ops.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_SECURITY_EMAIL=security@openspace.local
DEFAULT_SECURITY_PASSWORD=
