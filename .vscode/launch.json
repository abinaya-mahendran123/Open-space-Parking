{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Space Parking (Android phone)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "Prepare Android API",
      "toolArgs": [
        "--dart-define=BASE_API_URL=http://127.0.0.1:3000",
        "--dart-define=HOST_LAN_IP=192.168.88.8",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Open Space Parking (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=8080",
        "--dart-define=BASE_API_URL=http://localhost:3000",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Open Space Parking (Chrome, profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "profile",
      "toolArgs": [
        "--web-port=8080",
        "--dart-define=BASE_API_URL=http://localhost:3000",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=514956128372-a1aac5qlpe4s0i4ej0tqr6251m1uvb4k.apps.googleusercontent.com"
      ]
    }
  ]
